{
  "name": "family-fi",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run docker:up && bun run dev:web",
    "dev:web": "FAMILY_FI_API_UPSTREAM_ORIGIN=${FAMILY_FI_API_UPSTREAM_ORIGIN:-http://localhost:3001} turbo run dev --filter=web -- --port 5174",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:ps": "docker compose ps",
    "docker:up": "docker compose up --build -d api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.15",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
