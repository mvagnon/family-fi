generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id                             String                          @id
  spaceId                        String                          @unique @map("space_id")
  space                          Space                           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  members                        Json
  categories                     Json
  distributionLines              DistributionLine[]
  generatedRecurringLineSettings GeneratedRecurringLineSetting[]
  loans                          Loan[]
  loanRepaymentLines             LoanRepaymentLine[]
  recurringLines                 RecurringLine[]
  participationLines             ParticipationLine[]
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")

  @@map("family")
}

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  accounts      Account[]
  memberships   SpaceMembership[]
  sessions      Session[]
  settings      UserSettings?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Space {
  id           String            @id
  name         String
  currencyCode String            @default("EUR") @map("currency_code")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  family       Family?
  memberships  SpaceMembership[]
  defaultFor   UserSettings[]

  @@map("space")
}

model SpaceMembership {
  id        String   @id
  spaceId   String   @map("space_id")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_membership")
}

model UserSettings {
  userId         String   @id @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultSpaceId String?  @map("default_space_id")
  defaultSpace   Space?   @relation(fields: [defaultSpaceId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([defaultSpaceId])
  @@map("user_settings")
}

model RecurringLine {
  id               String   @id
  familyId         String   @map("family_id")
  family           Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title            String
  description      String
  categoryId       String   @map("category_id")
  movement         String
  amountCents      Int      @map("amount_cents")
  isEstimate       Boolean  @map("is_estimate")
  minAmountCents   Int?     @map("min_amount_cents")
  maxAmountCents   Int?     @map("max_amount_cents")
  recurrenceMonths Int      @map("recurrence_months")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([familyId])
  @@map("recurring_lines")
}

model GeneratedRecurringLineSetting {
  familyId  String   @map("family_id")
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  source    String
  sourceId  String   @map("source_id")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([familyId, source, sourceId])
  @@map("generated_recurring_line_settings")
}

model ParticipationLine {
  id          String   @id
  familyId    String   @map("family_id")
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId    String   @map("member_id")
  amountCents Int      @map("amount_cents")
  year        Int
  month       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([familyId])
  @@index([familyId, memberId])
  @@map("participation_lines")
}

model DistributionLine {
  id            String                     @id
  familyId      String                     @map("family_id")
  family        Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  amountCents   Int                        @map("amount_cents")
  memberAmounts DistributionMemberAmount[]
  year          Int
  month         Int
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@index([familyId])
  @@map("distribution_lines")
}

model DistributionMemberAmount {
  distributionLineId String           @map("distribution_line_id")
  distributionLine   DistributionLine @relation(fields: [distributionLineId], references: [id], onDelete: Cascade)
  memberId           String           @map("member_id")
  amountCents        Int              @map("amount_cents")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@id([distributionLineId, memberId])
  @@index([memberId])
  @@map("distribution_member_amounts")
}

model Loan {
  id                 String              @id
  familyId           String              @map("family_id")
  family             Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title              String
  initialAmountCents Int                 @map("initial_amount_cents")
  annualInterestRate Float               @map("annual_interest_rate")
  repaymentLines     LoanRepaymentLine[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([familyId])
  @@map("loans")
}

model LoanRepaymentLine {
  id        String   @id
  familyId  String   @map("family_id")
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  loanId    String   @map("loan_id")
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paidCents Int      @map("paid_cents")
  feesCents Int      @map("fees_cents")
  year      Int
  month     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([familyId])
  @@index([familyId, loanId])
  @@map("loan_repayment_lines")
}
