{
  "name": "api",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun run prisma:generate && tsx watch src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build": "bun run prisma:generate && tsc",
    "check-types": "bun run prisma generate && bun run tsc --noEmit",
    "prisma:deploy": "bun run prisma migrate deploy",
    "prisma:generate": "bun run prisma generate",
    "prisma:migrate": "bun run prisma migrate dev",
    "start": "bun dist/src/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/api-contracts": "*",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
