{
  "name": "api",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "docker compose --project-directory ../.. -f ../../docker-compose.yml up --build api",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build": "bun run prisma generate && bun run tsc",
    "check-types": "bun run prisma generate && bun run tsc --noEmit",
    "prisma:deploy": "bun run prisma migrate deploy",
    "prisma:generate": "bun run prisma generate",
    "prisma:migrate": "bun run prisma migrate dev",
    "start": "bun dist/src/index.js"
  },
  "dependencies": {
    "@repo/api-contracts": "*",
    "@hono/node-server": "^1.19.14",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
